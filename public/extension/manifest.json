{
  "manifest_version": 3,
  "name": "SkipMe",
  "version": "1.0.0",
  "description": "Automatically clicks YouTube's skip button when it appears.",
  "permissions": ["storage", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
